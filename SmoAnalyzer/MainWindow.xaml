<Window x:Class="SmoAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализ СМО — Практическая работа №14" Height="720" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <GroupBox Grid.Row="0" Header="1. Тип СМО" Margin="0,0,0,10">
            <ComboBox x:Name="cmbType" Margin="5" SelectedIndex="0"
                      SelectionChanged="CmbType_SelectionChanged">
                <ComboBoxItem>M/M/1 — одноканальная с неограниченной очередью</ComboBoxItem>
                <ComboBoxItem>M/M/1 — одноканальная с ограниченной очередью</ComboBoxItem>
                <ComboBoxItem>M/M/1 — одноканальная с отказами</ComboBoxItem>
                <ComboBoxItem>M/M/n — многоканальная с отказами</ComboBoxItem>
                <ComboBoxItem>M/M/n — многоканальная с неограниченной очередью</ComboBoxItem>
                <ComboBoxItem>M/M/n — многоканальная с ограниченной очередью</ComboBoxItem>
            </ComboBox>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="2. Исходные данные" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

         
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" VerticalAlignment="Center"
                           Text="λ — интенсивность поступления (1/ед. вр.):"/>
                <TextBox x:Name="txtLambda" Grid.Row="0" Grid.Column="1" Margin="5,4" Text="10"/>

               
                <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,4,0,4" VerticalAlignment="Center"
                           Text="Способ задания обслуживания:"/>
                <ComboBox x:Name="cmbServiceMode" Grid.Row="0" Grid.Column="3" Margin="5,4"
                          SelectedIndex="0" SelectionChanged="CmbServiceMode_SelectionChanged">
                    <ComboBoxItem>Задать μ (интенсивность)</ComboBoxItem>
                    <ComboBoxItem>Задать t_об (время обслуживания)</ComboBoxItem>
                </ComboBox>

              
                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="lblService" Margin="0,4" VerticalAlignment="Center"
                           Text="μ — интенсивность обслуживания (1/ед. вр.):"/>
                <TextBox x:Name="txtService" Grid.Row="1" Grid.Column="1" Margin="5,4" Text="12"/>

             
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="lblTimeUnit" Margin="10,4,0,4"
                           VerticalAlignment="Center" IsEnabled="False"
                           Text="Единицы t_об:"/>
                <ComboBox x:Name="cmbTimeUnit" Grid.Row="1" Grid.Column="3" Margin="5,4"
                          SelectedIndex="0" IsEnabled="False">
                    <ComboBoxItem>Как у λ (t_об в тех же единицах)</ComboBoxItem>
                    <ComboBoxItem>Минуты (λ задаётся в 1/час)</ComboBoxItem>
                </ComboBox>

               
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" VerticalAlignment="Center"
                           Text="n — число каналов:"/>
                <TextBox x:Name="txtN" Grid.Row="2" Grid.Column="1" Margin="5,4" Text="2" IsEnabled="False"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" VerticalAlignment="Center"
                           Text="m — длина очереди (мест ожидания):"/>
                <TextBox x:Name="txtM" Grid.Row="3" Grid.Column="1" Margin="5,4" Text="5" IsEnabled="False"/>

                
                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4" VerticalAlignment="Center"
                           Text="k — число заявок в очереди (для P(Lq ≤ k)):"/>
                <TextBox x:Name="txtK" Grid.Row="4" Grid.Column="1" Margin="5,4" Text="2"/>
            </Grid>
        </GroupBox>

        
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
           
            <Button Grid.Column="0" Content="3. Рассчитать характеристики"
                    Click="BtnCalculate_Click" Height="36" FontSize="14"/>
            
            <Button Grid.Column="1" Content="P(Lq ≤ k)" Padding="20,0" Height="36"
                    FontSize="14" Margin="10,0,0,0" Click="BtnQueueDist_Click"/>
        </Grid>

      
        <GroupBox Grid.Row="3" Header="Результаты">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtResults" Margin="10" FontFamily="Consolas" FontSize="13"
                           Text="Выберите тип СМО, введите исходные данные и нажмите «Рассчитать»."/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>